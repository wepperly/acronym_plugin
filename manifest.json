{
  "name": "NRAO Acronyms",
  "description": "Select an acronym to expand it.",
  "version": "1.0",
  "manifest_version": 3,

  "action": {
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png"
    },
    "default_popup": "./search-dropdown/search.html"
  },

  "permissions": ["contextMenus", "storage"],

  "options_ui": {
    "page": "./extension-options/options.html",
    "open_in_tab": false
  },

  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },

"web_accessible_resources": [
    {
      "resources": ["acronyms/NRAO-Acronyms.json"],
      "matches": ["<all_urls>"]
    }
]
}
